# Generated by 'pace install'; remove with 'pace uninstall'.
[Unit]
Description=pace resource governor
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="/home/me/my bin/pace%%1$$x" daemon
Restart=always
RestartSec=1
TimeoutStopSec=5
Environment=GOMEMLIMIT=16MiB
Environment=PACE_SOCK=/Users/me/g.sock
StandardOutput=append:/Users/me/Library/Logs/pace/daemon.log
StandardError=append:/Users/me/Library/Logs/pace/daemon.log
Delegate=yes

[Install]
WantedBy=default.target
